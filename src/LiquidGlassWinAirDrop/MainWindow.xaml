<Window x:Class="LiquidGlassWinAirDrop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiquidGlassWinAirDrop" Width="1200" Height="830" MinWidth="1040" MinHeight="750" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="14" Loaded="OnLoaded" MouseMove="OnPointerMove" Closing="OnClosing">
  <Border Margin="12" CornerRadius="28" BorderThickness="1" BorderBrush="#EFFFFFFF">
    <Border.Effect><DropShadowEffect Color="#4E5680" ShadowDepth="6" BlurRadius="25" Opacity="0.2"/></Border.Effect>
    <Grid ClipToBounds="True">
      <Border CornerRadius="27"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EFF1FB"/><GradientStop Color="#EDF3FB" Offset="0.5"/><GradientStop Color="#F4F1FB" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Canvas IsHitTestVisible="False" Opacity="0.8">
        <Ellipse Width="640" Height="600" Canvas.Left="360" Canvas.Top="-220" Fill="#CBCAFA"><Ellipse.Effect><BlurEffect Radius="105"/></Ellipse.Effect></Ellipse>
        <Ellipse Width="650" Height="470" Canvas.Left="440" Canvas.Top="310" Fill="#BCEAE9"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
        <Ellipse Width="440" Height="540" Canvas.Left="890" Canvas.Top="150" Fill="#E6CDF2"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
      </Canvas>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="DragTitle">
          <TextBlock Text="LiquidGlassWinAirDrop" FontSize="11" Foreground="#71809B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
            <Button Content="−" Width="35" Padding="0" Height="27" Background="Transparent" BorderBrush="Transparent" Click="Minimize" ToolTip="最小化" AutomationProperties.Name="最小化"/>
            <Button Content="□" Width="35" Padding="0" Height="27" Background="Transparent" BorderBrush="Transparent" Click="Maximize" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"/>
            <Button Content="×" Width="35" Padding="0" Height="27" Background="Transparent" BorderBrush="Transparent" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="18,0,24,22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions>
            <StackPanel Margin="17,14,0,0">
              <Border Width="48" Height="48" CornerRadius="16" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="White">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FEFFFF"/><GradientStop Color="#C3D8FA" Offset="0.55"/><GradientStop Color="#B4AAEF" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid><Ellipse Width="24" Height="24" Stroke="White" StrokeThickness="2"/><Ellipse Width="14" Height="14" Stroke="#819BE3" StrokeThickness="1.5"/><Ellipse Width="5" Height="5" Fill="#697DDD"/></Grid>
              </Border>
              <TextBlock Text="LiquidGlass" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <TextBlock Text="WIN AIRDROP" FontSize="10" Foreground="#8994AB" Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,28,0,0">
              <RadioButton x:Name="ReceiveNav" Style="{StaticResource Navigation}" GroupName="nav" Tag="receive" IsChecked="True" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Width="32" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="接收中心" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
              <RadioButton Style="{StaticResource Navigation}" GroupName="nav" Tag="history" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="32" FontSize="17"/><TextBlock Text="文件记录"/></StackPanel></RadioButton>
              <RadioButton Style="{StaticResource Navigation}" GroupName="nav" Tag="devices" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Width="32" FontSize="19"/><TextBlock Text="设备与连接"/></StackPanel></RadioButton>
              <RadioButton Style="{StaticResource Navigation}" GroupName="nav" Tag="settings" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="32" FontSize="17"/><TextBlock Text="偏好设置"/></StackPanel></RadioButton>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" CornerRadius="19" Padding="16" VerticalAlignment="Bottom">
              <StackPanel><TextBlock Text="你的 Windows" FontSize="11" Foreground="#78869D"/><TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#B39453" Margin="0,0,7,0"/><TextBlock Text="连接能力待就绪" FontSize="11" Foreground="#78869D"/></StackPanel></StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
            <Grid Margin="4,14,0,0"><StackPanel><TextBlock x:Name="PageTitle" Text="接收中心" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="把灵感和日常，轻盈地留在这里。" Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel><Button Content="↗  打开文件夹" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0" Click="OpenFolder"/></Grid>
            <Grid Grid.Row="1" x:Name="ReceivePage">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
              <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                <Grid ClipToBounds="True">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="32,24,4,24">
                    <Border HorizontalAlignment="Left" Background="#D8F1F0FF" CornerRadius="12" Padding="10,5"><TextBlock Text="一 点 轻 盈  ·  无 线 相 连" FontSize="10" Foreground="#737CB2"/></Border>
                    <TextBlock Text="让文件，&#x0a;轻盈抵达。" FontSize="38" FontWeight="SemiBold" LineHeight="53" Margin="0,20,0,12"/>
                    <TextBlock Text="为 Windows 打造的玻璃质感接收空间。&#x0a;连接就绪后，从 iPhone 的分享菜单开始。" FontSize="12" LineHeight="23" Foreground="#74809A"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="ScanButton" Content="⌁  检查连接" Style="{StaticResource Primary}" Click="ScanHardware"/><Button Content="查看设备" Margin="10,0,0,0" Click="ShowDevices"/></StackPanel>
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="-4,0,12,0" IsHitTestVisible="False">
                    <Ellipse x:Name="Halo" Width="255" Height="255" Fill="#52ABABF3"><Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect><Ellipse.RenderTransform><TranslateTransform x:Name="HaloMotion"/></Ellipse.RenderTransform></Ellipse>
                    <Ellipse Width="260" Height="260" Stroke="#95FFFFFF" StrokeThickness="1"/>
                    <Ellipse Width="214" Height="214" Stroke="#AAFFFFFF" StrokeThickness="1"/>
                    <Border Width="164" Height="164" CornerRadius="82" BorderThickness="1.5" BorderBrush="#F6FFFFFF" RenderTransformOrigin="0.5,0.5">
                      <Border.Effect><DropShadowEffect Color="#8892CD" Opacity="0.22" ShadowDepth="14" BlurRadius="30"/></Border.Effect>
                      <Border.Background><LinearGradientBrush StartPoint="0.12,0" EndPoint="0.9,1"><GradientStop Color="#FCFFFFFF"/><GradientStop Color="#BEDDEDFB" Offset="0.38"/><GradientStop Color="#72D5D6F8" Offset="0.7"/><GradientStop Color="#E8FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid><Ellipse Width="113" Height="113" Stroke="#A3FFFFFF" StrokeThickness="1"/><Ellipse Width="80" Height="80" Stroke="#9A9FCC" StrokeThickness="1.4"/><Ellipse Width="52" Height="52" Stroke="#9299C7" StrokeThickness="1.6"/><Path Data="M 0,22 L 15,0 L 30,22 Z" Fill="#7B8DC9" Width="30" Height="22" Stretch="Fill" VerticalAlignment="Center" Margin="0,3,0,0"/></Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,25"><TextBlock Text="等待连接" HorizontalAlignment="Center" FontSize="13" FontWeight="Medium"/><TextBlock Text="原生隔空投送接收尚未就绪" HorizontalAlignment="Center" FontSize="10" Foreground="#8590A9" Margin="0,7,0,0"/></StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassPanel}" Padding="24,20"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="最近的文件" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding FileCountLabel}" Style="{StaticResource Small}" HorizontalAlignment="Right"/></DockPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding LatestTitle}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding LatestSubtitle}" Style="{StaticResource Small}" Margin="0,8,0,0"/><TextBlock Text="文件会留在这里，随时可以打开。" FontSize="11" Foreground="#8C97AB" Margin="0,13,0,0"/></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="22,20"><StackPanel><TextBlock Text="连接概览" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding CompactHardware}" FontSize="12" LineHeight="23" Foreground="#6B7890" Margin="0,14,0,0"/><TextBlock Text="{Binding LastScanLabel}" FontSize="10" Foreground="#8C97AB" Margin="0,9,0,0"/></StackPanel></Border>
              </Grid>
            </Grid>
            <Border x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Padding="26">
              <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" TextChanged="SearchChanged" ToolTip="按文件名搜索" AutomationProperties.Name="搜索文件记录"/><TextBlock Text="{Binding FileCountLabel}" Foreground="#78869D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                <ListView Grid.Row="1" x:Name="FilesList" Margin="0,20,0,0" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Files}" MouseDoubleClick="OpenSelectedFile" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><Border Width="30" Height="36" Background="#B4E0E6FA" CornerRadius="7"><TextBlock Text="↧" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7EC4"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#7A87A0" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7A87A0" FontSize="12"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                <TextBlock x:Name="EmptyHistory" Grid.Row="1" Text="还没有文件记录。&#x0a;接收目录中的文件会显示在这里。" Foreground="#8B96AB" FontSize="15" LineHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <Border x:Name="DevicesPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Padding="28">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,22"><TextBlock Text="这台电脑的连接能力" FontSize="20" FontWeight="SemiBold"/><Button Content="重新检查" HorizontalAlignment="Right" Click="ScanHardware"/></DockPanel><TextBlock Text="{Binding HardwareHeadline}" FontSize="14" Foreground="#63718C" LineHeight="25"/><ItemsControl ItemsSource="{Binding HardwareCards}" Margin="0,22,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#80FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="17" Padding="20" Margin="0,0,0,13"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding State}" Foreground="#8E794B" HorizontalAlignment="Right" FontSize="12"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="#76839B" FontSize="12" LineHeight="22" Margin="0,9,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="设备检测只读取系统信息，不会替换驱动或切断网络。" FontSize="11" Foreground="#8B96AB" Margin="0,5,0,0"/></StackPanel></ScrollViewer>
            </Border>
            <Border x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Padding="30">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="让它更像你的空间" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,25"/><TextBlock Text="设备名称" FontSize="12" Foreground="#76839B" Margin="0,0,0,9"/><TextBox x:Name="DeviceNameBox" MaxLength="63" Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="接收位置" FontSize="12" Foreground="#76839B" Margin="0,24,0,9"/><DockPanel><Button Content="更改…" DockPanel.Dock="Right" Click="ChooseFolder" Margin="14,0,0,0"/><TextBlock Text="{Binding ReceiveDirectory}" VerticalAlignment="Center" FontSize="12" Foreground="#596984" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel><Border Background="#40FFFFFF" CornerRadius="16" Padding="18,8" Margin="0,25,0,25"><StackPanel><CheckBox x:Name="MotionBox" Content="流动光影与柔和动画" IsChecked="{Binding MotionEnabled}"/><TextBlock Text="关闭后使用静态玻璃外观，减少动态效果。" FontSize="11" Foreground="#8490A7" Margin="19,0,0,10"/><CheckBox x:Name="ContrastBox" Content="增强文字与玻璃对比度" IsChecked="{Binding HighContrast}"/></StackPanel></Border><Button Content="保存偏好设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveSettings"/><TextBlock Text="LiquidGlassWinAirDrop  ·  独立开发预览版 0.1" FontSize="11" Foreground="#8A96AA" Margin="0,30,0,0"/></StackPanel></ScrollViewer>
            </Border>
            <DockPanel Grid.Row="2" Margin="5,8,4,0"><TextBlock x:Name="FeedbackText" Text="独立开发预览版 · 原生接收引擎开发中" FontSize="10" Foreground="#7C8BA1"/><TextBlock Text="DESIGNED TO FEEL LIGHT." FontSize="9" Foreground="#A1ACC0" HorizontalAlignment="Right"/></DockPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
