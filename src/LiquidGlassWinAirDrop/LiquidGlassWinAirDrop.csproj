<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LiquidGlassWinAirDrop</AssemblyName>
    <RootNamespace>LiquidGlassWinAirDrop</RootNamespace>
    <Version>0.2.0</Version>
    <Description>An independent glass-inspired Windows file receiving application.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\LiquidGlassWinAirDrop.ico')">..\..\assets\LiquidGlassWinAirDrop.ico</ApplicationIcon>
    <Product>LiquidGlassWinAirDrop</Product>
  </PropertyGroup>
</Project>
